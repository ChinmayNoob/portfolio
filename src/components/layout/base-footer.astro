---
import { cfg } from '~/cfg';

const footerLinks = [
  { href: '/now', label: 'Now' },
  { href: '/lifeline', label: 'Lifeline' },
  { href: '/bookshelf', label: 'Bookshelf' },
  { href: '/guestbook', label: 'Guestbook' },
  { href: '/zibaldone', label: 'Zibaldone' },
  { href: '/directory', label: 'Directory' },
  { href: '/colophon', label: 'Colophon' },
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" transition:persist>
  <div class="footer-row">
    <p class="footer-copy">
      &copy; {currentYear} {cfg.bio.name}
    </p>
    <nav class="footer-links" aria-label="Footer">
      {
        footerLinks.map(({ href, label }) => (
          <a href={href}>{label}</a>
        ))
      }
      <a href="/rss.xml" target="_blank" rel="noopener noreferrer">RSS</a>
    </nav>
  </div>
  <p class="footer-note">
    <a
      href="https://www.who.int/health-topics/mental-health"
      target="_blank"
      rel="noopener noreferrer"
    >
      Take care of your mind.
    </a>
  </p>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    max-width: var(--spacing-page-w);
    width: 100%;
    margin: 0 auto;
    padding: 0 var(--spacing-page-x) var(--space-xl);
    border-top: 1px solid var(--c-divider);
    padding-top: var(--space-m);
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
  }

  .footer-copy {
    margin: 0;
    font-size: 0.875rem;
    color: var(--c-text-3);
    line-height: 1.5;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--c-text-3);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: color var(--duration-fast, 150ms) ease,
      text-decoration-color var(--duration-fast, 150ms) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-links a:hover {
      color: var(--c-text-1);
      text-decoration-color: currentColor;
    }
  }

  .footer-note {
    margin: var(--space-s) 0 0;
    font-size: 0.8rem;
    color: var(--c-text-3);
    line-height: 1.5;
  }

  .footer-note a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast, 150ms) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-note a:hover {
      color: var(--c-text-2);
    }
  }

  @media (max-width: 700px) {
    .footer-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }

    .footer-links {
      gap: 0.35rem 0.9rem;
    }
  }
</style>
