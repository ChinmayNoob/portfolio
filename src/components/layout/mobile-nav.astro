---
import { cn } from '~/lib/utils';
import ThemeToggle from '~/components/ui/theme-toggle.astro';

export type Props = {
  currentPath?: string;
};

const { currentPath = '/' } = Astro.props;

const mobileNavItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/art', label: 'Designs' },
  { href: '/posts', label: 'Posts' },
];
---

<header class="mobile-nav font-editorial text-base font-semibold">
  <nav class="mobile-nav-links" aria-label="Mobile navigation">
    <ThemeToggle />
    {mobileNavItems.map(({ href, label }) => {
      const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));
      return (
        <a
          href={href}
          class={cn(
            'rounded-md px-2.5 py-1 transition active:scale-95',
            isActive && 'mobile-nav-link-active',
          )}
        >
          {label}
        </a>
      );
    })}
  </nav>
</header>
