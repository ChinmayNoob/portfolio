---
import '~/styles/art.css';

import UnstyledBaseLayout from '~/components/layout/unstyled-base-layout.astro';
import ArtTopbar from '~/components/art/art-topbar.astro';
import ArtPanel from '~/components/art/art-panel.astro';
import ArtPreloader from '~/components/art/art-preloader.astro';
import { artPieces } from '~/lib/art-data';

const title = 'Art';
const description = 'A showcase of my designs and visual work.';

const first = artPieces[0];

/*
 * Only the nav's starting colour — once the page is live an observer hands it
 * whichever panel is under it. This just keeps the first paint correct.
 */
function readableTextOn(bg: string): string {
  const hex = bg.replace('#', '');
  if (!/^[0-9a-fA-F]{6}$/.test(hex)) return 'rgba(255, 255, 245, 0.92)';
  const r = parseInt(hex.slice(0, 2), 16) / 255;
  const g = parseInt(hex.slice(2, 4), 16) / 255;
  const b = parseInt(hex.slice(4, 6), 16) / 255;
  const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  return luminance > 0.55
    ? 'rgba(60, 60, 67, 0.92)'
    : 'rgba(255, 255, 245, 0.92)';
}

const navbarText = readableTextOn(
  first?.background?.kind === 'color' ? first.background.bg : '#1d283a',
);
---

<UnstyledBaseLayout seo={{ title, description }}>
  <ArtPreloader />
  <ArtTopbar text={navbarText} />
  <main class="art-main">
    {artPieces.map((piece, i) => (
      <ArtPanel piece={piece} index={i} />
    ))}

    <button
      id="art-to-top"
      type="button"
      aria-label="Scroll back to top"
      class="art-to-top"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5"></path>
        <path d="m5 12 7-7 7 7"></path>
      </svg>
    </button>
  </main>
</UnstyledBaseLayout>

<style>
  .art-to-top {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 245, 0.18);
    border-radius: 50%;
    background-color: rgba(29, 40, 58, 0.9);
    color: rgba(255, 255, 245, 0.92);
    backdrop-filter: blur(8px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.28);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition:
      opacity 250ms ease,
      transform 250ms ease,
      background-color 200ms ease;
  }

  .art-to-top.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .art-to-top:hover {
    background-color: rgba(29, 40, 58, 1);
  }

  .art-to-top:focus-visible {
    outline: 2px solid rgba(255, 255, 245, 0.5);
    outline-offset: 2px;
  }

  .art-to-top:active {
    transform: scale(0.94);
  }

  @media (max-width: 700px) {
    .art-to-top {
      right: 1rem;
      bottom: 1rem;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .art-to-top {
      transition: opacity 200ms ease;
      transform: none;
    }
  }
</style>

<style is:global>
  html.bookmarks-html,
  html.bookmarks-html body.bookmarks-body {
    height: auto;
    min-height: 100dvh;
  }

  html.bookmarks-html body.bookmarks-body {
    display: block;
  }

  /*
   * While the intro plays the page is pinned and hidden underneath it; the
   * preloader adds .art-revealed as it starts fading out, so the gallery eases
   * up into view underneath rather than snapping in after a black cut.
   */
  html.art-intro,
  html.art-intro body {
    overflow: hidden;
  }

  /*
   * The gallery is fully opaque the whole time — the overlay covers it, then
   * slides off. It only gets a small counter-lift so it settles into place as
   * the curtain clears, which reads as one motion rather than two layers
   * fading through each other.
   */
  html.art-intro body > *:not(.art-preloader) {
    transform: translateY(2.5rem);
    transition: transform 1150ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  html.art-intro.art-revealed body > *:not(.art-preloader) {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    html.art-intro body > *:not(.art-preloader) {
      transform: none;
      transition: none;
    }
  }

  .art-main {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: none;
    min-height: 0;
  }
</style>

<script>
  function initArtToTop() {
    const btn = document.getElementById('art-to-top');
    if (!btn) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      btn.classList.toggle(
        'is-visible',
        window.scrollY > window.innerHeight,
      );
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();

    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      html.style.scrollSnapType = 'none';
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      window.setTimeout(() => {
        html.style.scrollSnapType = '';
      }, reduce ? 0 : 700);
    });
  }

  document.addEventListener('astro:page-load', initArtToTop);
</script>
