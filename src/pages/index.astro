---
import ArrowUpRight from '~/assets/icons/arrow-up-right.svg';
import GitHubIcon from '~/assets/icons/github.svg';
import TwitterIcon from '~/assets/icons/twitter.svg';
import ABackgroundMobileDark from '~/assets/bento/a-background-mobile-dark.svg';
import ABackgroundMobileLight from '~/assets/bento/a-background-mobile-light.svg';
import ABackgroundDark from '~/assets/bento/a-background-dark.svg';
import ABackgroundLight from '~/assets/bento/a-background-light.svg';
import AForegroundMobileDark from '~/assets/bento/a-foreground-mobile-dark.svg';
import AForegroundMobileLight from '~/assets/bento/a-foreground-mobile-light.svg';
import AForegroundDark from '~/assets/bento/a-foreground-dark.svg';
import AForegroundLight from '~/assets/bento/a-foreground-light.svg';
import BBackgroundDark from '~/assets/bento/b-background-dark.svg';
import BBackgroundLight from '~/assets/bento/b-background-light.svg';
import BForegroundDark from '~/assets/bento/b-foreground-dark.svg';
import BForegroundLight from '~/assets/bento/b-foreground-light.svg';
import CImageDark from '~/assets/bento/c-dark.svg';
import CImageLight from '~/assets/bento/c-light.svg';
import EBackgroundMobileDark from '~/assets/bento/e-background-mobile-dark.svg';
import EBackgroundMobileLight from '~/assets/bento/e-background-mobile-light.svg';
import EBackgroundDark from '~/assets/bento/e-background-dark.svg';
import EBackgroundLight from '~/assets/bento/e-background-light.svg';
import EForegroundMobileDark from '~/assets/bento/e-foreground-mobile-dark.svg';
import EForegroundMobileLight from '~/assets/bento/e-foreground-mobile-light.svg';
import EForegroundDark from '~/assets/bento/e-foreground-dark.svg';
import EForegroundLight from '~/assets/bento/e-foreground-light.svg';
import FBackgroundDark from '~/assets/bento/f-background-dark.svg';
import FBackgroundLight from '~/assets/bento/f-background-light.svg';
import FForegroundDark from '~/assets/bento/f-foreground-dark.svg';
import FForegroundLight from '~/assets/bento/f-foreground-light.svg';
import GBackgroundDark from '~/assets/bento/g-background-dark.svg';
import GBackgroundLight from '~/assets/bento/g-background-light.svg';
import GForegroundDark from '~/assets/bento/g-foreground-dark.svg';
import GForegroundLight from '~/assets/bento/g-foreground-light.svg';
import HImageDark from '~/assets/bento/h-dark.svg';
import HImageLight from '~/assets/bento/h-light.svg';
import IBackgroundDark from '~/assets/bento/i-background-dark.svg';
import IBackgroundLight from '~/assets/bento/i-background-light.svg';
import IForegroundDark from '~/assets/bento/i-foreground-dark.svg';
import IForegroundLight from '~/assets/bento/i-foreground-light.svg';
import KBackgroundDark from '~/assets/bento/k-background-dark.svg';
import KBackgroundLight from '~/assets/bento/k-background-light.svg';
import KForegroundDark from '~/assets/bento/k-foreground-dark.svg';
import KForegroundLight from '~/assets/bento/k-foreground-light.svg';
import BaseLayout from '~/components/layout/base-layout.astro';
import DiscordPresence from '~/components/home/bento-discord-presence.astro';
import GithubCalendar from '~/components/home/bento-github-calendar.astro';
import MusicPlayer from '~/components/home/bento-music-player.astro';
import WakatimeGraph from '~/components/home/bento-wakatime-graph.astro';
import { cfg } from '~/cfg';
import { BENTO } from '~/data/bento';
import { getPostsCollection, postLeadImage } from '~/lib/mdx/post';

const githubHref = cfg.bio.links.find((l) => l.label === 'github')?.url ?? '#';
const xHref = cfg.bio.links.find((l) => l.label === 'x')?.url ?? '#';

const latestPost = (await getPostsCollection()).at(0);
const latestPostImage = latestPost ? postLeadImage(latestPost) : null;
---

<BaseLayout wide seo={{ title: cfg.title, description: cfg.description }}>
  <bento-container>
    <bento-grid>
      <bento-cell style="grid-area: a">
        <bento-layer data-desktop>
          <ABackgroundDark data-theme-dark preserveAspectRatio="xMidYMid slice" />
          <ABackgroundLight data-theme-light preserveAspectRatio="xMidYMid slice" />
        </bento-layer>
        <bento-layer data-mobile>
          <ABackgroundMobileDark data-theme-dark preserveAspectRatio="xMidYMid slice" />
          <ABackgroundMobileLight data-theme-light preserveAspectRatio="xMidYMid slice" />
        </bento-layer>
        <bento-layer data-desktop data-overlay>
          <AForegroundDark data-theme-dark preserveAspectRatio="xMidYMid slice" />
          <AForegroundLight data-theme-light preserveAspectRatio="xMidYMid slice" />
          <bento-note-stack data-note="about">
            <bento-note>
              Hey, I&rsquo;m Chinmay! I&rsquo;m a software engineer writing about
              distributed systems, algorithms, AI, and modern React development.
            </bento-note>
            <bento-note data-tail="left">
              You can read more about me <a href="/about">here</a>, or see what
              I&rsquo;m up to right now <a href="/now">on this page</a>.
            </bento-note>
          </bento-note-stack>
        </bento-layer>
        <bento-layer data-mobile data-overlay>
          <AForegroundMobileDark data-theme-dark preserveAspectRatio="xMidYMid slice" />
          <AForegroundMobileLight data-theme-light preserveAspectRatio="xMidYMid slice" />
          <bento-note-stack data-note="about">
            <bento-note>
              Hey, I&rsquo;m Chinmay! I&rsquo;m a software engineer.
            </bento-note>
            <bento-note data-tail="down">
              You can read more about me <a href="/about">here</a>, or see what
              I&rsquo;m up to right now <a href="/now">on this page</a>.
            </bento-note>
          </bento-note-stack>
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: b" data-trigger>
        <bento-layer>
          <BBackgroundDark data-theme-dark />
          <BBackgroundLight data-theme-light />
        </bento-layer>
        <bento-layer data-reveal>
          <BForegroundDark data-theme-dark />
          <BForegroundLight data-theme-light />
          <bento-note data-note="details" data-tail="right">
            I hope you enjoy reading my posts!
          </bento-note>
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: c" data-cover>
        <bento-layer>
          <CImageDark data-theme-dark preserveAspectRatio="xMidYMid slice" />
          <CImageLight data-theme-light preserveAspectRatio="xMidYMid slice" />
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: d"><DiscordPresence /></bento-cell>
      <bento-cell style="grid-area: e" data-trigger>
        <bento-layer data-desktop>
          <EBackgroundDark data-theme-dark preserveAspectRatio="xMidYMax slice" />
          <EBackgroundLight data-theme-light preserveAspectRatio="xMidYMax slice" />
        </bento-layer>
        <bento-layer data-mobile>
          <EBackgroundMobileDark data-theme-dark preserveAspectRatio="xMidYMax slice" />
          <EBackgroundMobileLight data-theme-light preserveAspectRatio="xMidYMax slice" />
        </bento-layer>
        {
          latestPost && (
            <Fragment>
              {latestPostImage && (
                <bento-layer data-post-art>
                  <img
                    src={latestPostImage.src}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </bento-layer>
              )}
              <bento-layer data-content>
              <a
                href={`/posts/${latestPost.slug}`}
                data-post-card
                data-has-art={latestPostImage ? '' : undefined}
              >
                <span data-post-kicker>Latest post</span>
                <span data-post-title>{latestPost.data.title}</span>
                <span data-post-description>{latestPost.data.description}</span>
              </a>
              <a
                href={`/posts/${latestPost.slug}`}
                data-action
                title={`Read latest post: ${latestPost.data.title}`}
                aria-label={`Read latest post: ${latestPost.data.title}`}
              >
                <ArrowUpRight aria-hidden="true" />
              </a>
              </bento-layer>
            </Fragment>
          )
        }
        <bento-layer data-desktop data-reveal>
          <EForegroundDark data-theme-dark preserveAspectRatio="xMidYMax slice" />
          <EForegroundLight data-theme-light preserveAspectRatio="xMidYMax slice" />
          <bento-note data-note="blog" data-tail="up">Read my<br />latest post!</bento-note>
        </bento-layer>
        <bento-layer data-mobile data-reveal>
          <EForegroundMobileDark data-theme-dark preserveAspectRatio="xMidYMax slice" />
          <EForegroundMobileLight data-theme-light preserveAspectRatio="xMidYMax slice" />
          <bento-note data-note="blog" data-tail="left">Read my latest<br />post!</bento-note>
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: f" data-trigger data-cover>
        <bento-layer data-content>
          <GithubCalendar username={BENTO.githubUsername} />
        </bento-layer>
        <bento-layer>
          <FBackgroundDark data-theme-dark preserveAspectRatio="xMinYMid slice" />
          <FBackgroundLight data-theme-light preserveAspectRatio="xMinYMid slice" />
        </bento-layer>
        <bento-layer data-reveal>
          <FForegroundDark data-theme-dark preserveAspectRatio="xMinYMid slice" />
          <FForegroundLight data-theme-light preserveAspectRatio="xMinYMid slice" />
          <bento-note data-note="calendar" data-tail="down">
            Check out my<br />
            GitHub calendar!
          </bento-note>
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: g" data-trigger>
        <bento-layer>
          <GBackgroundDark data-theme-dark />
          <GBackgroundLight data-theme-light />
        </bento-layer>
        <bento-layer data-reveal>
          <GForegroundDark data-theme-dark />
          <GForegroundLight data-theme-light />
        </bento-layer>
        <bento-layer data-content>
          <MusicPlayer />
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: h">
        <bento-layer>
          <HImageDark data-theme-dark preserveAspectRatio="xMidYMid slice" />
          <HImageLight data-theme-light preserveAspectRatio="xMidYMid slice" />
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: i" data-trigger>
        <bento-layer>
          <IBackgroundDark data-theme-dark />
          <IBackgroundLight data-theme-light />
        </bento-layer>
        <bento-layer data-reveal>
          <IForegroundDark data-theme-dark />
          <IForegroundLight data-theme-light />
        </bento-layer>
        <bento-layer data-content>
          <bento-mark><GitHubIcon aria-hidden="true" /></bento-mark>
          <a
            href={githubHref}
            data-action
            target="_blank"
            rel="noopener noreferrer"
            title="Visit my GitHub profile"
            aria-label="Visit my GitHub profile"
          >
            <ArrowUpRight aria-hidden="true" />
          </a>
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: j"><WakatimeGraph /></bento-cell>
      <bento-cell style="grid-area: k" data-trigger>
        <bento-layer>
          <KBackgroundDark data-theme-dark />
          <KBackgroundLight data-theme-light />
        </bento-layer>
        <bento-layer data-reveal>
          <KForegroundDark data-theme-dark />
          <KForegroundLight data-theme-light />
        </bento-layer>
        <bento-layer data-content>
          <bento-mark><TwitterIcon aria-hidden="true" /></bento-mark>
          <a
            href={xHref}
            data-action
            target="_blank"
            rel="noopener noreferrer"
            title="Visit my X profile"
            aria-label="Visit my X profile"
          >
            <ArrowUpRight aria-hidden="true" />
          </a>
        </bento-layer>
      </bento-cell>
    </bento-grid>
  </bento-container>
</BaseLayout>

<style>
  bento-container {
    display: block;
    container-type: inline-size;
  }

  bento-grid {
    --bento-gap: var(--space-xs);

    display: grid;
    gap: var(--bento-gap);
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'a' 'b' 'e' 'd' 'g' 'f' 'j' 'i' 'k';

    @media (width < 30rem) {
      bento-cell {
        aspect-ratio: 1;
      }

      bento-cell:nth-of-type(1) {
        aspect-ratio: 3 / 4;
      }

      bento-cell:nth-of-type(4) {
        container-type: inline-size;
        aspect-ratio: auto;
      }

      bento-cell:nth-of-type(5) {
        aspect-ratio: 6 / 5;
      }

      bento-cell:nth-of-type(3),
      bento-cell:nth-of-type(8) {
        display: none;
      }
    }

    @media (width >= 30rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: calc((100cqw - var(--bento-gap)) / 2);
      grid-template-areas:
        'a a'
        'b d'
        'e e'
        'j g'
        'h i'
        'h c'
        'k c'
        'f f';
    }

    @media (width >= 56rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: calc((100cqw - 2 * var(--bento-gap)) / 3);
      grid-template-areas:
        'a a b'
        'd e e'
        'h f f'
        'h i g'
        'k c j';
    }

    @media (width >= 80rem) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: calc((100cqw - 3 * var(--bento-gap)) / 4);
      grid-template-areas:
        'a a b c'
        'd e e c'
        'h f f g'
        'h i j k';
    }
  }

  bento-cell {
    container-type: size;
    position: relative;
    display: block;
    overflow: hidden;
    border: 2px solid var(--border);
  }

  bento-layer {
    position: absolute;
    inset: 0;
    display: block;
  }

  /*
   * NOTE: `:global()` must stay at the top level of these selectors. Astro 5
   * does not compile `:global()` inside a nested rule — it emits it verbatim,
   * which the browser then discards along with the whole declaration block.
   */
  bento-layer :global(svg),
  bento-layer :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  bento-layer :global(img) {
    object-fit: cover;
  }

  bento-layer[data-mobile] {
    display: none;
  }

  @media (width < 30rem) {
    bento-layer[data-desktop] {
      display: none;
    }

    bento-layer[data-mobile] {
      display: block;
    }
  }

  bento-layer[data-reveal],
  bento-layer[data-overlay] {
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  @media (width >= 30rem) {
    bento-layer[data-reveal] {
      opacity: 0;
    }

    bento-cell[data-trigger]:hover bento-layer[data-reveal] {
      opacity: 1;
    }

    bento-grid:has(bento-cell[data-trigger]:hover) bento-layer[data-overlay] {
      opacity: 0;
    }
  }

  bento-layer[data-content] {
    pointer-events: none;
  }

  /*
   * The layer swallows pointer events so the cell's hover-reveal still works,
   * so every interactive child has to opt back in — including the music
   * player's controls, which are created in JS and therefore need :global().
   */
  bento-layer[data-content] :global(a),
  bento-layer[data-content] :global(button),
  bento-layer[data-content] :global(music-track) {
    pointer-events: auto;
  }

  /*
   * enscribe fills this tile with the post's banner image; posts here have no
   * image field, so it carries the post's title instead.
   */
  a[data-post-card] {
    position: absolute;
    inset: var(--space-s);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-3xs);
    padding-inline-end: 4rem;
    color: var(--foreground);
    /* styles/links.css underlines every classless <a>; not wanted here. */
    text-decoration: none;
  }

  a[data-post-card]:hover span[data-post-title] {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }

  /*
   * The post's lead image, treated like the other photography in the grid
   * (the Discord avatar, the album art) so it sits in the same palette.
   * A scrim keeps the title legible over whatever the image happens to be.
   */
  bento-layer[data-post-art] {
    overflow: hidden;
  }

  bento-layer[data-post-art] :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) sepia(0.3);
    opacity: 0.55;
  }

  bento-layer[data-post-art]::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--background) 0%,
      color-mix(in oklab, var(--background) 70%, transparent) 38%,
      transparent 70%
    );
  }

  a[data-post-card][data-has-art] span[data-post-description] {
    display: none;
  }

  span[data-post-kicker] {
    color: var(--primary);
    font-size: clamp(0.75rem, 1.75cqw, 0.9375rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  span[data-post-title] {
    font-size: clamp(1.125rem, 3.25cqw, 2rem);
    font-weight: var(--font-weight-semibold);
    line-height: 1.15;
    text-wrap: balance;
  }

  span[data-post-description] {
    color: var(--muted-foreground);
    font-size: clamp(0.8125rem, 1.9cqw, 1.0625rem);
    line-height: 1.4;
    text-wrap: pretty;
  }

  bento-note {
    position: absolute;
    display: block;
    pointer-events: auto;
    padding: var(--space-3xs) var(--space-2xs);
    border: 2px solid var(--background-l4);
    background-color: var(--background);
    color: var(--prose-foreground);
    font-size: var(--note-text, clamp(0.8125rem, 4.5cqw, 1rem));
    line-height: calc(0.4rem + 1em);
    text-wrap: pretty;

    a {
      color: var(--foreground);
      text-decoration: underline;
      text-decoration-color: var(--muted-foreground);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    &[data-tail]::after {
      content: '';
      position: absolute;
      inline-size: 0.625rem;
      block-size: 0.625rem;
      rotate: 45deg;
      background-color: var(--background);
      border: 2px solid var(--background-l4);
    }

    &[data-tail='up']::after {
      inset-block-start: calc(-0.3125rem - 1.5px);
      inset-inline-start: var(--tail-x, 50%);
      translate: -50% 0;
      border-inline-end: none;
      border-block-end: none;
    }

    &[data-tail='down']::after {
      inset-block-end: calc(-0.3125rem - 1.5px);
      inset-inline-start: var(--tail-x, 50%);
      translate: -50% 0;
      border-inline-start: none;
      border-block-start: none;
    }

    &[data-tail='left']::after {
      inset-inline-start: calc(-0.3125rem - 1.5px);
      inset-block-start: var(--tail-y, 50%);
      translate: 0 -50%;
      border-inline-end: none;
      border-block-start: none;
    }

    &[data-tail='right']::after {
      inset-inline-end: calc(-0.3125rem - 1.5px);
      inset-block-start: var(--tail-y, 50%);
      translate: 0 -50%;
      border-inline-start: none;
      border-block-end: none;
    }
  }

  bento-note-stack {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);

    bento-note {
      --tail-y: 30%;

      position: relative;
      inset: auto;
    }
  }

  bento-note-stack[data-note='about'] {
    --note-text: clamp(0.8125rem, 2.25cqw, 1rem);

    inset-block-start: var(--space-s);
    inset-inline-end: var(--space-s);
    inline-size: min(60%, 26rem);

    bento-note {
      padding: clamp(0.5rem, 1.4cqw, 0.75rem);
    }
  }

  bento-layer[data-mobile] bento-note-stack[data-note='about'] {
    --note-text: clamp(0.9375rem, 4.5cqw, 1.1875rem);

    --tail-x: 20%;

    inset-inline: var(--space-xs);
    inset-block-start: var(--space-xs);
    inline-size: auto;

    bento-note {
      padding: clamp(0.5rem, 3cqw, 1rem);
    }
  }

  bento-note[data-note='details'] {
    --tail-y: 80%;

    inset-block-start: 65%;
    inset-inline-start: var(--space-xs);
    translate: 0 -50%;
    max-inline-size: calc(100% - 6rem);
  }

  bento-note[data-note='blog'] {
    --note-text: clamp(0.8125rem, 2.25cqw, 1rem);

    --tail-x: 70%;

    inset-block-start: 48%;
    inset-inline-end: var(--space-xs);
    translate: 0 -50%;
  }

  bento-layer[data-mobile] bento-note[data-note='blog'] {
    inset-block-start: auto;
    inset-block-end: var(--space-xs);
    inset-inline: 4rem auto;
    translate: none;
  }

  bento-note[data-note='calendar'] {
    --note-text: clamp(0.8125rem, 2.25cqw, 1rem);
    --tail-x: 15%;

    inset-block-start: 30%;
    inset-inline-start: var(--space-xs);
    translate: 0 -50%;
  }

  bento-mark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bento-mark-color);
  }

  bento-mark :global(svg) {
    width: 50%;
    height: 50%;
  }

  @media (width >= 30rem) {
    bento-mark :global(svg) {
      width: 6rem;
      height: 6rem;
    }
  }

  a[data-action] {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: var(--space-2xs);
    padding: 0.75rem;
    border-radius: var(--radius-full);
    background-color: color-mix(in oklab, var(--border) 50%, transparent);
    color: var(--primary);
    transition: box-shadow 0.3s ease;

    &:hover,
    &:focus-visible {
      box-shadow: 0 0 0 2px var(--ring);
    }
  }

  a[data-action] :global(svg) {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s ease;
  }

  a[data-action]:hover :global(svg) {
    transform: rotate(12deg);
  }
</style>
