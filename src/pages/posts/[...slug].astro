---
import {
  getCollection,
  type CollectionEntry,
} from 'astro:content';
import PostLayout from '~/components/layout/post-layout.astro';
import {
  getPostsCollection,
  getRelatedPosts,
  isDraft,
} from '~/lib/mdx/post';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  return allPosts
    .filter((post) => !isDraft(post))
    .map((post) => ({
      params: { slug: post.slug.replace(/\/index$/, '') },
      props: { post },
    }));
}

const { post } = Astro.props as { post: CollectionEntry<'posts'> };

const posts = await getPostsCollection();
const index = posts.findIndex((p) => p.id === post.id);

const prevPost = index >= 0 ? posts[index + 1] : undefined;
const nextPost = index >= 0 ? posts[index - 1] : undefined;
const relatedPosts = getRelatedPosts(post, posts);
---

<PostLayout
  post={post}
  prevPost={prevPost}
  nextPost={nextPost}
  relatedPosts={relatedPosts}
/>
